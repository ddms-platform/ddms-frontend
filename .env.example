VITE_APP_NAME=DDMS - Đặt tour đường thủy Đà Nẵng

# Backend API origin (no trailing slash). Use HTTPS port to avoid preflight redirect.
VITE_API_URL=https://localhost:7161
# Path prefix appended to the API origin -> https://localhost:7161/api
VITE_API_URL_PREFIX=api
# development | production
VITE_APP_MODE=development

# Google OAuth client id (must match backend Google:clientId)
VITE_GOOGLE_CLIENT_ID=
